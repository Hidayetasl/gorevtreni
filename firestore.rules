rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aile kodu 12 rastgele karakterdir. Yalnızca oturum açmış uygulama istemcileri
    // bu kodla erişebilir. Daha ileri erişim kontrolü için Firebase Auth hesabı eklenebilir.
    match /families/{familyCode} {
      allow read, write: if request.auth != null;
    }
  }
}
