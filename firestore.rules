rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Yalnızca e-posta/şifre ile giriş yapmış yetişkin hesapları. Eski anonim
    // "çocuk olarak devam" oturumları artık hiçbir aile verisine erişemez.
    function signedIn() {
      // Yalnızca yetişkin hesapları (e-posta/şifre ya da Google); anonim oturum kabul edilmez.
      return request.auth != null && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }

    function familyPath(familyCode) {
      return /databases/$(database)/documents/families/$(familyCode);
    }

    function isFamilyMember(familyCode) {
      return signedIn()
        && (resource.data.get('ownerUid', '') == request.auth.uid
          || resource.data.get('memberUids', []).hasAny([request.auth.uid]));
    }

    function invitePath(token) {
      return /databases/$(database)/documents/familyJoinInvites/$(token);
    }

    // Aile belgesini okumadan üyelik kontrolü (davet oluştururken).
    function isMemberOf(familyCode) {
      let family = get(familyPath(familyCode)).data;
      return signedIn()
        && (family.get('ownerUid', '') == request.auth.uid
          || family.get('memberUids', []).hasAny([request.auth.uid]));
    }

    function isFamilyOwner() {
      return signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // Yetişkinin kendi kaydı: bağlı olduğu aile kodu (yeni cihazda kod yazmadan
    // aileyi bulmak için). Başkasının kaydı okunamaz.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Davet belgesi yalnızca kodun aktif olup olmadığını taşır; aile verisini taşımaz.
    match /familyInvites/{familyCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.familyCode == familyCode;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.familyCode == resource.data.familyCode;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Tek kullanımlık, 7 gün geçerli, kişiye özel (ad) davet. Yalnızca aile
    // üyesi oluşturur; davet edilen kişi kullanınca "kullanıldı" işaretlenir.
    match /familyJoinInvites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && token.size() >= 20
        && request.resource.data.keys().hasOnly(['familyCode', 'name', 'createdBy', 'createdAt', 'expiresAt', 'usedBy', 'usedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 24 * 60 * 60 * 1000
        && request.resource.data.usedBy == null
        && isMemberOf(request.resource.data.familyCode);
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Davetle katılım: davet aynı anda (toplu yazmada) bu kişi adına
    // "kullanıldı" işaretlenmeli, bu aileye ait ve süresi dolmamış olmalı.
    function joinsWithInvite(familyCode) {
      let token = request.resource.data.get('joinInvite', '');
      let before = get(invitePath(token)).data;
      let after = getAfter(invitePath(token)).data;
      return token is string && token.size() >= 20
        && before.usedBy == null
        && after.usedBy == request.auth.uid
        && after.familyCode == familyCode
        && after.expiresAt > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt', 'adultNames', 'joinInvite'])
        && request.resource.data.memberUids.hasAll(resource.data.get('memberUids', []))
        && request.resource.data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.memberUids.size() == resource.data.get('memberUids', []).size() + 1
        && request.resource.data.adultNames.diff(resource.data.get('adultNames', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.adultNames[request.auth.uid] == after.name;
    }

    match /families/{familyCode} {
      // İlk cihaz aileyi oluşturur; ownerUid ve kendi UID'si memberUids içine yazılmalıdır.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasAny([request.auth.uid]);

      // Yeni aile oluşturma öncesindeki getDoc(false) çağrısı reddedilmez; mevcut veri ise üyeye aittir.
      allow get: if signedIn()
        && (!exists(familyPath(familyCode)) || isFamilyMember(familyCode));
      allow list: if false;

      // Daveti kabul eden yeni üye sadece memberUids + updatedAt alanını ekleyebilir.
      allow update: if signedIn() && (
        isFamilyOwner()
        || joinsWithInvite(familyCode)
        || (
          resource.data.get('inviteEnabled', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        )
        || (
          isFamilyMember(familyCode)
          && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
          && request.resource.data.get('memberUids', []) == resource.data.get('memberUids', [])
          && request.resource.data.get('inviteEnabled', false) == resource.data.get('inviteEnabled', false)
        )
      );

      allow delete: if isFamilyOwner();
    }
  }
}
