rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her cihaz arka planda anonim Firebase oturumu açar. Aile belgesi adı
    // rastgele davet kodudur; kod bilinmeden veriye erişilemez.
    match /families/{familyCode} {
      allow read, write: if request.auth != null;
    }
  }
}
