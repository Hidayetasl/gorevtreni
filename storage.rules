rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      // Yalnızca yetişkin hesapları (e-posta/şifre ya da Google); anonim oturum kabul edilmez.
      return request.auth != null && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }

    function familyDoc(familyCode) {
      return firestore.get(/databases/(default)/documents/families/$(familyCode));
    }

    // Süreli davetle katılanın erişimi süre bitince kapanır (Firestore kuralıyla aynı).
    function accessOpen(familyCode) {
      return familyDoc(familyCode).data.get('memberExpiry', {}).get(request.auth.uid, 0) == 0
        || familyDoc(familyCode).data.get('memberExpiry', {}).get(request.auth.uid, 0) > request.time.toMillis();
    }

    function isFamilyMember(familyCode) {
      return signedIn()
        && (familyDoc(familyCode).data.ownerUid == request.auth.uid
          || (familyDoc(familyCode).data.memberUids.hasAny([request.auth.uid]) && accessOpen(familyCode)));
    }

    match /families/{familyCode}/voice/{fileName} {
      allow read: if isFamilyMember(familyCode);
      allow create, update: if isFamilyMember(familyCode)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isFamilyMember(familyCode);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
